{
  "name": "paw-pine",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Paw & Pine — a headless Shopify storefront for premium pet accessories.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:shopify": "npx --yes tsx --tsconfig tsconfig.json scripts/seed-shopify.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "~20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "~3.2.7"
  },
  "overrides": {
    "typescript": "~5.9.3"
  }
}
