# Public site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, analytics events are also forwarded to a dataLayer
# compatible with Google Tag Manager / GA4.
NEXT_PUBLIC_GTM_ID=

# Optional. When true, analytics events are also printed to the browser console.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Shopify Storefront API (server only — never NEXT_PUBLIC_*).
# Use the Headless channel Storefront token, not an Admin API token (shpat_…).
# The public 32-character token and the private token both work; do not wrap in quotes.
# When domain + token are set, the app uses the live shop.
# When they are absent, the app uses the local demo catalogue.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
